# PiPedal bass pedal — /boot/firmware/config.txt fragment
#
# HiFiBerry DAC+ ADC Pro keeps I2C1 (BCM 2/3) and I2S (BCM 18-21).
# OLEDs use SPI0 MOSI/SCLK only. PCF8575 uses a *second* I2C bus on
# BCM 22/23 so it never shares the HiFiBerry control bus.
#
# Append these lines. Do not enable dtparam=i2c_arm=on for the expander.

dtparam=audio=off
dtoverlay=hifiberry-dacplusadcpro

# SPI0: BCM 10 MOSI (header pin 19), BCM 11 SCLK (header pin 23).
# Chip-select is software-driven via the PCF8575. Kernel CE0/CE1 stay unused.
dtparam=spi=on

# Dedicated expander I2C on BCM 22 (SDA, pin 15) and BCM 23 (SCL, pin 16).
# Pi 4 uses BSC I2C6; Pi 5 uses RP1 I2C3. Both appear as a bus other than 1.
[pi4]
dtoverlay=i2c6,pins_22_23,baudrate=100000

[pi5]
dtoverlay=i2c3-pi5,pins_22_23,baudrate=100000

[all]
# Fallback if the hardware I2C overlay is missing (any 40-pin Pi):
# dtoverlay=i2c-gpio,bus=3,i2c_gpio_sda=22,i2c_gpio_scl=23
#
# After reboot:
#   i2cdetect -l
#   i2cdetect -y <expander-bus>     # expect 0x20 (default A0/A1/A2 low)
# Never scan /dev/i2c-1 — that is the HiFiBerry PCM5122/PCM1863 bus.
