# Build a Raspberry Pi OS / Debian arm64 .deb.
# On a Mac: docker/build-deb.sh
# For Bluetooth/UI-only updates after the fork is installed: docker/push-pi.sh
#
# Apple Silicon is native linux/arm64. Intel Macs qemu-emulate it (slow).

FROM debian:trixie AS build

ENV DEBIAN_FRONTEND=noninteractive \
    CMAKE_BUILD_TYPE=Release \
    CCACHE_DIR=/root/.ccache \
    CMAKE_C_COMPILER_LAUNCHER=ccache \
    CMAKE_CXX_COMPILER_LAUNCHER=ccache \
    npm_config_cache=/root/.npm

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg \
        cmake ninja-build build-essential git pkg-config python3 gzip file ccache \
        dpkg-dev fakeroot binutils xz-utils zstd libdpkg-perl \
        nodejs npm \
        liblilv-dev libboost-dev \
        libsystemd-dev catch2 \
        libasound2-dev uuid-dev \
        authbind libavahi-client-dev libnm-dev libicu-dev \
        libsdbus-c++-dev libsdbus-c++-bin \
        libzip-dev libzstd-dev \
        libgoogle-perftools-dev \
        libpipewire-0.3-dev libbz2-dev libssl-dev librsvg2-dev \
        libnl-3-dev libnl-genl-3-dev \
        libcairo2 libx11-6 libpango-1.0-0 librsvg2-2 libxrandr2 \
        libpipewire-0.3-0 liblilv-0-0 libavahi-client3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# npm deps: only invalidated when package files change
COPY vite/package.json vite/package-lock.json /src/vite/
WORKDIR /src/vite
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund

WORKDIR /src
COPY . .

RUN if [ ! -f modules/SQLiteCpp/CMakeLists.txt ]; then \
         echo "Submodules are missing. On the host run: git submodule update --init --recursive" >&2; \
         exit 1; \
       fi

RUN cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DPIPEDAL_EXCLUDE_TESTS=ON \
        -DPIPEDAL_DISABLE_COPYRIGHT_BUILD=ON \
        -DPIPEDAL_DEB_SIGN=OFF \
        -DPIPEDAL_DEB_SHLIBDEPS=OFF

RUN --mount=type=cache,target=/root/.ccache \
    cmake --build build -j"$(nproc)"

RUN cmake --build build --target package \
    && mkdir -p /out \
    && cp -a build/*.deb /out/

FROM scratch AS export
COPY --from=build /out /
