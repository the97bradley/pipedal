#!/bin/sh
# Allow SSH, HTTP, and mDNS from clients on the PiPedal auto-hotspot.
# NetworkManager runs this as root. CONNECTION_ID is the NM connection name.

IFACE="${1:-}"
ACTION="${2:-}"

[ -n "$IFACE" ] || exit 0

if [ "${CONNECTION_ID:-}" != "PiPedal Hotspot" ]; then
    exit 0
fi

HOST="$(hostname 2>/dev/null || echo raspberrypi)"
DNSMASQ_DIR="/etc/NetworkManager/dnsmasq-shared.d"
DNSMASQ_CONF="${DNSMASQ_DIR}/pipedal.conf"
HOTSPOT_IP="192.168.60.1"

ensure_dns_names() {
    mkdir -p "$DNSMASQ_DIR" 2>/dev/null || true
    cat > "$DNSMASQ_CONF" <<EOF
# Generated by PiPedal hotspot dispatcher so pipedal.local and the
# system hostname resolve on the auto-hotspot (needed for iPad/iOS).
address=/pipedal.local/${HOTSPOT_IP}
address=/pipedal/${HOTSPOT_IP}
address=/${HOST}.local/${HOTSPOT_IP}
address=/${HOST}/${HOTSPOT_IP}
address=/raspberrypi.local/${HOTSPOT_IP}
address=/raspberrypi/${HOTSPOT_IP}
EOF
}

ensure_input_accept() {
    # iptables-nft on Bookworm/Trixie; ignore if the command is missing.
    if ! command -v iptables >/dev/null 2>&1; then
        return 0
    fi
    iptables -C INPUT -i "$IFACE" -j ACCEPT >/dev/null 2>&1 || \
        iptables -I INPUT -i "$IFACE" -j ACCEPT
    iptables -C OUTPUT -o "$IFACE" -j ACCEPT >/dev/null 2>&1 || \
        iptables -I OUTPUT -o "$IFACE" -j ACCEPT
}

drop_input_accept() {
    if ! command -v iptables >/dev/null 2>&1; then
        return 0
    fi
    iptables -D INPUT -i "$IFACE" -j ACCEPT >/dev/null 2>&1 || true
    iptables -D OUTPUT -o "$IFACE" -j ACCEPT >/dev/null 2>&1 || true
}

case "$ACTION" in
    pre-up|up)
        ensure_dns_names
        ensure_input_accept
        ;;
    down|pre-down)
        drop_input_accept
        ;;
esac

exit 0
