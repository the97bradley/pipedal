#!/usr/bin/python3
"""BlueZ agent: iPad types the Settings PIN.

SSP numeric comparison is tap-Pair with a random number. That is not a PIN.
Legacy PIN (SSP off) is RequestPinCode: this process returns the configured
PIN, the iPad keypad sends what the user typed, the controller compares.

Do not run hciconfig/btmgmt from this process. That drops the ACL during
PIN Code Reply. Do not rotate 001037/1037 across retries; the iPad still
has the PIN the user typed.
"""
import os
import sys
import time
import dbus
import dbus.service
import dbus.mainloop.glib
from gi.repository import GLib

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, "/usr/lib/pipedal")
from pipedal_bt_pin import PIN_REPLY_MS, read_pin  # noqa: E402

PIN_FILE = "/run/pipedal/bt-pin"
AGENT_PATH = "/org/pipedal/bt_agent"
CAPABILITY = "KeyboardOnly"
HANDSHAKE_SEC = 35


def log(msg):
    print(f"pipedal-bt-agent: {msg}", file=sys.stderr, flush=True)


class Rejected(dbus.DBusException):
    _dbus_error_name = "org.bluez.Error.Rejected"


class Canceled(dbus.DBusException):
    _dbus_error_name = "org.bluez.Error.Canceled"


class Agent(dbus.service.Object):
    def __init__(self, bus, path):
        super().__init__(bus, path)
        self._handshake_until = 0.0
        self._pin_src = None
        self._pin_reply = None
        self._pin_error = None

    def _begin_handshake(self):
        self._handshake_until = time.time() + HANDSHAKE_SEC
        log(f"handshake open {HANDSHAKE_SEC}s")

    def in_handshake(self):
        return time.time() < self._handshake_until

    def _pin(self):
        return read_pin(PIN_FILE)

    def _cancel_pending_pin(self, send_error=False):
        src = self._pin_src
        err = self._pin_error
        self._pin_src = None
        self._pin_reply = None
        self._pin_error = None
        if src is not None:
            GLib.source_remove(src)
        if send_error and err is not None:
            try:
                err(Canceled("cancelled"))
            except Exception:
                pass

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Release(self):
        self._cancel_pending_pin()
        log("Release")

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def AuthorizeService(self, device, uuid):
        log(f"AuthorizeService {device} {uuid}")
        return

    @dbus.service.method(
        "org.bluez.Agent1",
        in_signature="o",
        out_signature="s",
        async_callbacks=("reply_handler", "error_handler"),
    )
    def RequestPinCode(self, device, reply_handler, error_handler):
        p = self._pin()
        if not p:
            error_handler(Rejected("No PIN configured"))
            return
        self._begin_handshake()
        self._cancel_pending_pin()
        self._pin_reply = reply_handler
        self._pin_error = error_handler
        log(f"RequestPinCode {device} keypad up; send {p} in {PIN_REPLY_MS}ms")

        def send():
            self._pin_src = None
            self._pin_reply = None
            self._pin_error = None
            log(f"RequestPinCode {device} -> {p}")
            try:
                reply_handler(p)
            except Exception as exc:
                log(f"RequestPinCode reply failed: {exc}")
            return False

        self._pin_src = GLib.timeout_add(PIN_REPLY_MS, send)

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="u")
    def RequestPasskey(self, device):
        log(f"rejected SSP passkey request from {device}")
        raise Rejected("PIN required")

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="")
    def RequestAuthorization(self, device):
        log(f"rejected Just Works from {device}")
        raise Rejected("PIN required")

    @dbus.service.method("org.bluez.Agent1", in_signature="ou", out_signature="")
    def RequestConfirmation(self, device, passkey):
        log(f"rejected SSP passkey {int(passkey):06d} from {device}; iPad must type PIN")
        raise Rejected("PIN required")

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def DisplayPinCode(self, device, pincode):
        log(f"DisplayPinCode {device} {pincode}")

    @dbus.service.method("org.bluez.Agent1", in_signature="ouq", out_signature="")
    def DisplayPasskey(self, device, passkey, entered):
        log(f"DisplayPasskey {device} {int(passkey):06d} entered={int(entered)}")

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Cancel(self):
        log("Cancel")
        self._cancel_pending_pin(send_error=True)


def main():
    global PIN_FILE
    if len(sys.argv) >= 2:
        PIN_FILE = sys.argv[1]
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()
    agent = Agent(bus, AGENT_PATH)

    def manager():
        return dbus.Interface(
            bus.get_object("org.bluez", "/org/bluez"), "org.bluez.AgentManager1"
        )

    def claim_agent():
        if agent.in_handshake():
            return True
        try:
            mgr = manager()
            try:
                mgr.RegisterAgent(AGENT_PATH, CAPABILITY)
            except dbus.exceptions.DBusException:
                pass
            mgr.RequestDefaultAgent(AGENT_PATH)
        except dbus.exceptions.DBusException:
            pass
        return True

    def adapter_once():
        try:
            props = dbus.Interface(
                bus.get_object("org.bluez", "/org/bluez/hci0"),
                "org.freedesktop.DBus.Properties",
            )
            props.Set("org.bluez.Adapter1", "Powered", dbus.Boolean(True))
            props.Set("org.bluez.Adapter1", "Pairable", dbus.Boolean(True))
            props.Set("org.bluez.Adapter1", "DiscoverableTimeout", dbus.UInt32(0))
            props.Set("org.bluez.Adapter1", "Discoverable", dbus.Boolean(True))
        except dbus.exceptions.DBusException:
            pass

    try:
        manager().UnregisterAgent(AGENT_PATH)
    except dbus.exceptions.DBusException:
        pass
    adapter_once()
    claim_agent()
    log(f"{CAPABILITY} default agent (iPad types PIN {read_pin(PIN_FILE) or '?'})")
    GLib.timeout_add(2000, claim_agent)
    GLib.MainLoop().run()


if __name__ == "__main__":
    os.environ.setdefault("PYTHONUNBUFFERED", "1")
    main()
