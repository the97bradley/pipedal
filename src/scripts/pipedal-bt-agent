#!/usr/bin/python3
"""BlueZ pairing agent for iPadOS.

iPadOS classic pairing is SSP numeric comparison: it shows a random 6-digit
code and asks the user to tap Pair. That is RequestConfirmation, NOT our
Settings PIN. Rejecting those codes is why pairing failed.

RequestPinCode / RequestPasskey still return the configured PIN if iOS uses
passkey entry. RequestAuthorization (no-UI Just Works) is rejected.
"""
import os
import sys
import dbus
import dbus.service
import dbus.mainloop.glib
from gi.repository import GLib

PIN_FILE = "/run/pipedal/bt-pin"
AGENT_PATH = "/org/pipedal/bt_agent"
CAPABILITY = "DisplayYesNo"


def log(msg):
    print(f"pipedal-bt-agent: {msg}", file=sys.stderr, flush=True)


def read_pin():
    try:
        with open(PIN_FILE, encoding="utf-8") as f:
            line = f.readline().strip()
        if line.startswith("* "):
            line = line[2:].strip()
        if line.isdigit() and 4 <= len(line) <= 8:
            return line
    except OSError:
        pass
    env = os.environ.get("PIPEDAL_BT_PIN", "").strip()
    if env.isdigit() and 4 <= len(env) <= 8:
        return env
    return ""


def pin_int():
    pin = read_pin()
    return int(pin) if pin else 0


class Rejected(dbus.DBusException):
    _dbus_error_name = "org.bluez.Error.Rejected"


class Agent(dbus.service.Object):
    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Release(self):
        log("Release")

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def AuthorizeService(self, device, uuid):
        log(f"AuthorizeService {device} {uuid}")
        return

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="s")
    def RequestPinCode(self, device):
        pin = read_pin()
        if not pin:
            raise Rejected("No PIN configured")
        log(f"RequestPinCode {device} -> {pin}")
        return pin

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="u")
    def RequestPasskey(self, device):
        value = pin_int()
        if not value:
            raise Rejected("No PIN configured")
        log(f"RequestPasskey {device} -> {value:06d}")
        return dbus.UInt32(value)

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="")
    def RequestAuthorization(self, device):
        log(f"rejected Just Works from {device}")
        raise Rejected("Confirmation required")

    @dbus.service.method("org.bluez.Agent1", in_signature="ou", out_signature="")
    def RequestConfirmation(self, device, passkey):
        # iPadOS numeric comparison. The 6-digit code is random, not our PIN.
        log(f"RequestConfirmation {device} {int(passkey):06d} accepted")
        return

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def DisplayPinCode(self, device, pincode):
        log(f"DisplayPinCode {device} {pincode}")

    @dbus.service.method("org.bluez.Agent1", in_signature="ouq", out_signature="")
    def DisplayPasskey(self, device, passkey, entered):
        log(f"DisplayPasskey {device} {int(passkey)} entered={int(entered)}")

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Cancel(self):
        log("Cancel")


def main():
    global PIN_FILE
    if len(sys.argv) >= 2:
        PIN_FILE = sys.argv[1]
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()
    Agent(bus, AGENT_PATH)

    def manager():
        return dbus.Interface(
            bus.get_object("org.bluez", "/org/bluez"), "org.bluez.AgentManager1"
        )

    def claim():
        try:
            mgr = manager()
            try:
                mgr.RegisterAgent(AGENT_PATH, CAPABILITY)
            except dbus.exceptions.DBusException:
                pass
            mgr.RequestDefaultAgent(AGENT_PATH)
        except dbus.exceptions.DBusException:
            pass
        try:
            props = dbus.Interface(
                bus.get_object("org.bluez", "/org/bluez/hci0"),
                "org.freedesktop.DBus.Properties",
            )
            props.Set("org.bluez.Adapter1", "Powered", dbus.Boolean(True))
            props.Set("org.bluez.Adapter1", "Pairable", dbus.Boolean(True))
            props.Set("org.bluez.Adapter1", "DiscoverableTimeout", dbus.UInt32(0))
            props.Set("org.bluez.Adapter1", "Discoverable", dbus.Boolean(True))
        except dbus.exceptions.DBusException:
            pass
        return True

    try:
        manager().UnregisterAgent(AGENT_PATH)
    except dbus.exceptions.DBusException:
        pass
    claim()
    log(f"{CAPABILITY} default agent (iPad numeric comparison accepted)")
    GLib.timeout_add(200, claim)
    GLib.MainLoop().run()


if __name__ == "__main__":
    os.environ.setdefault("PYTHONUNBUFFERED", "1")
    main()
