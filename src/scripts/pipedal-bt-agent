#!/usr/bin/python3
"""BlueZ agent: pre-shared PIN typed on the iPad, compared on the Pi.

SSP numeric comparison (RequestConfirmation with a random 6-digit code)
is rejected — that is the tap-Pair path anyone nearby can complete.

PIN Code Reply is held for 30 seconds so the handshake stays up while
the iPad keypad is used. Immediate reply was Authentication Failure in
~100ms — Pairing Unsuccessful after the PIN was typed.
"""
import os
import sys
import dbus
import dbus.service
import dbus.mainloop.glib
from gi.repository import GLib

PIN_FILE = "/run/pipedal/bt-pin"
AGENT_PATH = "/org/pipedal/bt_agent"
CAPABILITY = "KeyboardOnly"
PIN_WAIT_SEC = 30


def log(msg):
    print(f"pipedal-bt-agent: {msg}", file=sys.stderr, flush=True)


def read_pin():
    try:
        with open(PIN_FILE, encoding="utf-8") as f:
            line = f.readline().strip()
        if line.startswith("* "):
            line = line[2:].strip()
        if line.isdigit() and 4 <= len(line) <= 8:
            return line
    except OSError:
        pass
    env = os.environ.get("PIPEDAL_BT_PIN", "").strip()
    if env.isdigit() and 4 <= len(env) <= 8:
        return env
    return ""


def pin_for_ipad():
    pin = read_pin()
    if not pin:
        return ""
    if len(pin) < 6:
        pin = pin.zfill(6)
    return pin


class Rejected(dbus.DBusException):
    _dbus_error_name = "org.bluez.Error.Rejected"


class Agent(dbus.service.Object):
    def __init__(self, bus, path):
        super().__init__(bus, path)
        self._cancel = False
        self._bus = bus
        self._pairing = set()
        self._pin_timer = None
        self._handshake = False

    def _clear_pin_timer(self):
        if self._pin_timer is not None:
            GLib.source_remove(self._pin_timer)
            self._pin_timer = None

    def _hold_pin(self, kind, device, pin, reply_handler, error_handler):
        self._cancel = False
        self._handshake = True
        self._clear_pin_timer()
        log(f"{kind} {device} handshake held {PIN_WAIT_SEC}s for iPad keypad ({pin})")

        def finish():
            self._pin_timer = None
            self._handshake = False
            if self._cancel:
                log(f"{kind} {device} cancelled")
                error_handler(Rejected("Cancelled"))
                return False
            log(f"{kind} {device} -> {pin}")
            reply_handler(pin if kind == "RequestPinCode" else dbus.UInt32(int(pin)))
            return False

        self._pin_timer = GLib.timeout_add_seconds(PIN_WAIT_SEC, finish)

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Release(self):
        log("Release")
        self._clear_pin_timer()
        self._handshake = False

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def AuthorizeService(self, device, uuid):
        log(f"AuthorizeService {device} {uuid}")
        return

    @dbus.service.method(
        "org.bluez.Agent1",
        in_signature="o",
        out_signature="s",
        async_callbacks=("reply_handler", "error_handler"),
    )
    def RequestPinCode(self, device, reply_handler, error_handler):
        pin = pin_for_ipad()
        if not pin:
            error_handler(Rejected("No PIN configured"))
            return
        self._hold_pin("RequestPinCode", device, pin, reply_handler, error_handler)

    @dbus.service.method(
        "org.bluez.Agent1",
        in_signature="o",
        out_signature="u",
        async_callbacks=("reply_handler", "error_handler"),
    )
    def RequestPasskey(self, device, reply_handler, error_handler):
        pin = pin_for_ipad()
        if not pin:
            error_handler(Rejected("No PIN configured"))
            return
        self._hold_pin("RequestPasskey", device, pin, reply_handler, error_handler)

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="")
    def RequestAuthorization(self, device):
        log(f"rejected Just Works from {device}")
        raise Rejected("PIN required")

    @dbus.service.method("org.bluez.Agent1", in_signature="ou", out_signature="")
    def RequestConfirmation(self, device, passkey):
        log(f"rejected numeric-comparison {int(passkey):06d} from {device} (type-in PIN required)")
        raise Rejected("PIN required")

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def DisplayPinCode(self, device, pincode):
        log(f"DisplayPinCode {device} {pincode} (type this on the iPad)")

    @dbus.service.method("org.bluez.Agent1", in_signature="ouq", out_signature="")
    def DisplayPasskey(self, device, passkey, entered):
        log(f"DisplayPasskey {device} {int(passkey):06d} entered={int(entered)}")

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Cancel(self):
        log("Cancel")
        self._cancel = True
        self._handshake = False
        self._clear_pin_timer()

    def pair_unpaired_connected(self):
        if self._handshake:
            return True
        try:
            om = dbus.Interface(
                self._bus.get_object("org.bluez", "/"),
                "org.freedesktop.DBus.ObjectManager",
            )
            for path, ifaces in om.GetManagedObjects().items():
                dev = ifaces.get("org.bluez.Device1")
                if not dev:
                    continue
                if dev.get("Paired") or not dev.get("Connected"):
                    self._pairing.discard(str(path))
                    continue
                path_s = str(path)
                if path_s in self._pairing:
                    continue
                self._pairing.add(path_s)
                log(f"Pi initiating PIN pair {path_s} {dev.get('Address')}")
                try:
                    dbus.Interface(
                        self._bus.get_object("org.bluez", path), "org.bluez.Device1"
                    ).Pair()
                except dbus.exceptions.DBusException as e:
                    log(f"Pair {path_s}: {e.get_dbus_name()}")
        except dbus.exceptions.DBusException:
            pass
        return True


def main():
    global PIN_FILE
    if len(sys.argv) >= 2:
        PIN_FILE = sys.argv[1]
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()
    agent = Agent(bus, AGENT_PATH)

    def manager():
        return dbus.Interface(
            bus.get_object("org.bluez", "/org/bluez"), "org.bluez.AgentManager1"
        )

    def claim_agent():
        try:
            mgr = manager()
            try:
                mgr.RegisterAgent(AGENT_PATH, CAPABILITY)
            except dbus.exceptions.DBusException:
                pass
            mgr.RequestDefaultAgent(AGENT_PATH)
        except dbus.exceptions.DBusException:
            pass
        return True

    def adapter_once():
        try:
            props = dbus.Interface(
                bus.get_object("org.bluez", "/org/bluez/hci0"),
                "org.freedesktop.DBus.Properties",
            )
            props.Set("org.bluez.Adapter1", "Powered", dbus.Boolean(True))
            props.Set("org.bluez.Adapter1", "Pairable", dbus.Boolean(True))
            props.Set("org.bluez.Adapter1", "DiscoverableTimeout", dbus.UInt32(0))
            props.Set("org.bluez.Adapter1", "Discoverable", dbus.Boolean(True))
        except dbus.exceptions.DBusException:
            pass

    try:
        manager().UnregisterAgent(AGENT_PATH)
    except dbus.exceptions.DBusException:
        pass
    adapter_once()
    claim_agent()
    log(f"{CAPABILITY} default agent (iPad must type PIN {pin_for_ipad() or '?'}; handshake {PIN_WAIT_SEC}s)")
    GLib.timeout_add(2000, claim_agent)
    GLib.timeout_add(1000, agent.pair_unpaired_connected)
    GLib.MainLoop().run()


if __name__ == "__main__":
    os.environ.setdefault("PYTHONUNBUFFERED", "1")
    main()
