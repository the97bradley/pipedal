#!/usr/bin/python3
"""Compare the typed PIN, then open PiPedal on the PAN.

iOS legacy PIN pairing never delivers the keypad digits to userspace;
the controller returns Authentication Failure even when both sides use
001037. After the Bluetooth link is up, HTTP on pan0 collects the PIN,
compares it, and only then exposes the PiPedal UI.
"""
import os
import subprocess
import sys
import urllib.parse
from http.server import BaseHTTPRequestHandler, HTTPServer

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, "/usr/lib/pipedal")
from pipedal_bt_pin import pins_match, read_pin as read_pin_file  # noqa: E402

PIN_FILE = "/run/pipedal/bt-pin"
UNLOCKED = "/run/pipedal/bt-unlocked"
LISTEN = ("172.21.0.1", 8099)
NFT_TABLE = "pipedal_bt"

# Pairing is open. pan0 may only reach SSH and PiPedal (plus DHCP/DNS).
NFT_LOCK_SCRIPT = f"""
table ip {NFT_TABLE} {{
    chain input {{
        type filter hook input priority filter; policy accept;
        iifname "pan0" ct state established,related accept
        iifname "pan0" udp dport {{ 53, 67 }} accept
        iifname "pan0" tcp dport {{ 22, 53, 80 }} accept
        iifname "pan0" drop
    }}
}}
table ip6 {NFT_TABLE} {{
    chain input {{
        type filter hook input priority filter; policy accept;
        iifname "pan0" drop
    }}
}}
"""


def nft_lock():
    subprocess.call(["nft", "delete", "table", "ip", NFT_TABLE], stderr=subprocess.DEVNULL)
    subprocess.call(["nft", "delete", "table", "ip6", NFT_TABLE], stderr=subprocess.DEVNULL)
    proc = subprocess.run(
        ["nft", "-f", "-"], input=NFT_LOCK_SCRIPT, text=True, capture_output=True
    )
    if proc.returncode != 0:
        log(f"nft lock failed: {proc.stderr.strip()}")
        return False
    return True


def nft_unlock():
    subprocess.call(["nft", "delete", "table", "ip", NFT_TABLE], stderr=subprocess.DEVNULL)
    subprocess.call(["nft", "delete", "table", "ip6", NFT_TABLE], stderr=subprocess.DEVNULL)


def log(msg):
    print(f"pipedal-bt-auth: {msg}", file=sys.stderr, flush=True)


def read_pin():
    return read_pin_file(PIN_FILE)


def lock_ui():
    try:
        os.remove(UNLOCKED)
    except OSError:
        pass
    nft_lock()
    log("PiPedal UI locked until PIN matches")


def unlock_ui():
    with open(UNLOCKED, "w", encoding="utf-8") as f:
        f.write("ok\n")
    nft_unlock()
    log("PIN matched; PiPedal UI unlocked")


PAGE = """<!doctype html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PiPedal PIN</title>
</head>
<body style="font-family:sans-serif;max-width:22em;margin:3em auto;padding:0 1em">
<h1 style="font-size:1.4em">PiPedal</h1>
<p>Type the pairing PIN and submit. Compare is immediate.</p>
<form method="post">
<input name="pin" inputmode="numeric" pattern="[0-9]*" maxlength="8" autocomplete="off" autofocus
 style="font-size:1.4em;width:8em;letter-spacing:0.15em">
<button type="submit" style="font-size:1.1em;margin-left:0.5em">Connect</button>
</form>
<p style="color:#b00020">{err}</p>
</body>
</html>
"""


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        log(fmt % args)

    def _html(self, status, body):
        data = body.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if os.path.exists(UNLOCKED):
            self.send_response(302)
            self.send_header("Location", "/")
            self.end_headers()
            return
        self._html(200, PAGE.format(err=""))

    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(length).decode("utf-8", "replace")
        got = (urllib.parse.parse_qs(raw).get("pin") or [""])[0].strip()
        expected = read_pin()
        matched = pins_match(got, expected)
        log(f"interrupt: received PIN {got!r} from {self.client_address[0]} match={matched}")
        if matched:
            unlock_ui()
            self.send_response(302)
            self.send_header("Location", "/")
            self.end_headers()
            return
        self._html(403, PAGE.format(err="Wrong PIN"))


def main():
    if len(sys.argv) >= 2:
        global PIN_FILE
        PIN_FILE = sys.argv[1]
    lock_ui()
    httpd = HTTPServer(LISTEN, Handler)
    log(f"comparing PIN on {LISTEN[0]}:{LISTEN[1]}")
    try:
        httpd.serve_forever()
    finally:
        nft_unlock()


if __name__ == "__main__":
    os.environ.setdefault("PYTHONUNBUFFERED", "1")
    main()
