#!/bin/bash
# PiPedal Bluetooth NAP (Network Access Point).
#
# Gives the iPad a second, Bluetooth-only IP path to the Pi so the iPad can
# stay on Wi-Fi (or cellular) for internet. DHCP does not advertise a default
# route; the PAN is 172.21.0.0/24 with the Pi at 172.21.0.1.
#
# Hidden unless Settings → Bluetooth remote → Allow new devices (2 minutes).
# NAP is BR/EDR only. BLE Just Works pairing is disabled so a rando cannot
# "connect" without a PIN and without a network.

set -u

CONFIG_JSON="/var/pipedal/config/bluetoothConfig.json"
BRIDGE="pan0"
DUMMY="pan0-dummy"
ADDR="172.21.0.1"
PREFIX="24"
DHCP_START="172.21.0.10"
DHCP_END="172.21.0.50"
RUN_DIR="/run/pipedal"
DNSMASQ_CONF="${RUN_DIR}/bt-dnsmasq.conf"
DNSMASQ_LEASES="${RUN_DIR}/bt-dnsmasq.leases"
PIN_FILE="${RUN_DIR}/bt-pin"
PAIRING_FLAG="${RUN_DIR}/bt-pairing-on"
AGENT_PID=""
AGENT_READER_PID=""
TRUST_PID=""
KEEPALIVE_PID=""
NETWORK_PID=""
DNSMASQ_PID=""
BTCTL_PID=""
NAME=""
PIN=""
PAIRING_UNTIL=0
PAIRING_ACTIVE=0

log() {
    echo "pipedal-bt-nap: $*" >&2
}

load_config() {
    local loaded
    loaded="$(python3 - <<'PY' 2>/dev/null
import json, os, secrets, time
path = "/var/pipedal/config/bluetoothConfig.json"
data = {}
if os.path.exists(path):
    try:
        with open(path) as f:
            data = json.load(f)
    except Exception:
        data = {}
name = (data.get("deviceName") or "pipedal").strip() or "pipedal"
pin = str(data.get("pin") or "").strip()
changed = False
if not (pin.isdigit() and 4 <= len(pin) <= 8):
    pin = f"{secrets.randbelow(1000000):06d}"
    data["deviceName"] = name
    data["pin"] = pin
    data["enable"] = True
    changed = True
allow = data.get("allowNewDevices")
if allow is None:
    allow = True
if changed:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump(data, f)
print(name)
print(pin)
print(1 if allow else 0)
PY
)"
    NAME="$(printf '%s\n' "$loaded" | sed -n '1p')"
    PIN="$(printf '%s\n' "$loaded" | sed -n '2p')"
    PAIRING_UNTIL="$(printf '%s\n' "$loaded" | sed -n '3p')"
    if [[ -z "$NAME" ]]; then
        NAME="pipedal"
    fi
    if [[ ! "$PIN" =~ ^[0-9]{4,8}$ ]]; then
        log "failed to load a valid Bluetooth PIN"
        exit 1
    fi
    if [[ "$PAIRING_UNTIL" != "1" ]]; then
        PAIRING_UNTIL=0
    fi
}

set_classic_nap_adapter() {
    # NAP is a classic (BR/EDR) service. If LE stays on, iPadOS pairs BLE
    # with Just Works: Connected, no PIN, no Ethernet/PAN.
    if command -v btmgmt >/dev/null 2>&1; then
        btmgmt power off >/dev/null 2>&1 || true
        btmgmt le off >/dev/null 2>&1 || true
        btmgmt advertising off >/dev/null 2>&1 || true
        btmgmt bredr on >/dev/null 2>&1 || true
        btmgmt ssp off >/dev/null 2>&1 || true
        btmgmt sc off >/dev/null 2>&1 || true
        btmgmt io-cap 4 >/dev/null 2>&1 || true
        btmgmt name "$NAME" >/dev/null 2>&1 || true
        btmgmt connectable on >/dev/null 2>&1 || true
        btmgmt pairable off >/dev/null 2>&1 || true
        btmgmt discov off >/dev/null 2>&1 || true
        btmgmt power on >/dev/null 2>&1 || true
        btmgmt ssp off >/dev/null 2>&1 || true
        btmgmt le off >/dev/null 2>&1 || true
        btmgmt connectable on >/dev/null 2>&1 || true
    fi
    if command -v hciconfig >/dev/null 2>&1; then
        # Networking + Computer so iPadOS can offer Ethernet/PAN.
        hciconfig hci0 class 0x020100 >/dev/null 2>&1 || true
        hciconfig hci0 sspmode 0 >/dev/null 2>&1 || true
        hciconfig hci0 noleadv >/dev/null 2>&1 || true
        # Page scan only: paired devices can reconnect; inquiry off so randos
        # do not see us.
        hciconfig hci0 pscan >/dev/null 2>&1 || true
    fi
    bluetoothctl power on >/dev/null 2>&1 || true
    bluetoothctl system-alias "$NAME" >/dev/null 2>&1 || bluetoothctl alias "$NAME" >/dev/null 2>&1 || true
    bluetoothctl pairable off >/dev/null 2>&1 || true
    bluetoothctl discoverable off >/dev/null 2>&1 || true
}

set_pairing_visible() {
    local on="$1"
    if [[ "$on" == 1 ]]; then
        if command -v btmgmt >/dev/null 2>&1; then
            btmgmt pairable on >/dev/null 2>&1 || true
            btmgmt discov on >/dev/null 2>&1 || true
            btmgmt connectable on >/dev/null 2>&1 || true
            btmgmt ssp off >/dev/null 2>&1 || true
            btmgmt le off >/dev/null 2>&1 || true
        fi
        if command -v hciconfig >/dev/null 2>&1; then
            hciconfig hci0 class 0x020100 >/dev/null 2>&1 || true
            hciconfig hci0 sspmode 0 >/dev/null 2>&1 || true
            hciconfig hci0 piscan >/dev/null 2>&1 || true
        fi
        bluetoothctl pairable on >/dev/null 2>&1 || true
        bluetoothctl discoverable-timeout 0 >/dev/null 2>&1 || true
        bluetoothctl discoverable on >/dev/null 2>&1 || true
        touch "$PAIRING_FLAG"
        if [[ "$PAIRING_ACTIVE" != 1 ]]; then
            log "pairing window open. iPad must enter PIN ${PIN}"
        fi
        PAIRING_ACTIVE=1
    else
        rm -f "$PAIRING_FLAG"
        bluetoothctl pairable off >/dev/null 2>&1 || true
        bluetoothctl discoverable off >/dev/null 2>&1 || true
        if command -v btmgmt >/dev/null 2>&1; then
            btmgmt pairable off >/dev/null 2>&1 || true
            btmgmt discov off >/dev/null 2>&1 || true
            btmgmt connectable on >/dev/null 2>&1 || true
            btmgmt le off >/dev/null 2>&1 || true
            btmgmt ssp off >/dev/null 2>&1 || true
        fi
        if command -v hciconfig >/dev/null 2>&1; then
            hciconfig hci0 pscan >/dev/null 2>&1 || true
            hciconfig hci0 sspmode 0 >/dev/null 2>&1 || true
        fi
        if [[ "$PAIRING_ACTIVE" == 1 ]]; then
            log "pairing window closed. adapter hidden; paired devices can still reconnect"
        fi
        PAIRING_ACTIVE=0
    fi
}

cleanup() {
    if [[ -n "${DNSMASQ_PID}" ]]; then
        kill "${DNSMASQ_PID}" >/dev/null 2>&1 || true
    fi
    if [[ -n "${NETWORK_PID}" ]]; then
        kill "${NETWORK_PID}" >/dev/null 2>&1 || true
    fi
    if [[ -n "${AGENT_PID}" ]]; then
        kill "${AGENT_PID}" >/dev/null 2>&1 || true
    fi
    if [[ -n "${AGENT_READER_PID}" ]]; then
        kill "${AGENT_READER_PID}" >/dev/null 2>&1 || true
    fi
    if [[ -n "${TRUST_PID}" ]]; then
        kill "${TRUST_PID}" >/dev/null 2>&1 || true
    fi
    if [[ -n "${KEEPALIVE_PID}" ]]; then
        kill "${KEEPALIVE_PID}" >/dev/null 2>&1 || true
    fi
    if [[ -n "${BTCTL_PID}" ]]; then
        kill "${BTCTL_PID}" >/dev/null 2>&1 || true
    fi
    rm -f "$PAIRING_FLAG"
    for adapter in /org/bluez/hci0 /org/bluez/hci1; do
        dbus-send --system --dest=org.bluez --type=method_call \
            "$adapter" org.bluez.NetworkServer1.Unregister string:nap \
            >/dev/null 2>&1 || true
    done
    ip link set "$DUMMY" nomaster >/dev/null 2>&1 || true
    ip link delete "$DUMMY" >/dev/null 2>&1 || true
    ip addr flush dev "$BRIDGE" >/dev/null 2>&1 || true
    ip link set "$BRIDGE" down >/dev/null 2>&1 || true
    ip link delete "$BRIDGE" type bridge >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

if [[ ! -d /sys/class/bluetooth ]] || [[ -z "$(ls -A /sys/class/bluetooth 2>/dev/null)" ]]; then
    log "no Bluetooth adapter found"
    exit 1
fi

if ! command -v bluetoothctl >/dev/null 2>&1; then
    log "bluetoothctl not found (install bluez)"
    exit 1
fi
if ! command -v dnsmasq >/dev/null 2>&1; then
    log "dnsmasq not found"
    exit 1
fi

modprobe bnep >/dev/null 2>&1 || true
modprobe bridge >/dev/null 2>&1 || true
modprobe dummy >/dev/null 2>&1 || true

load_config
log "starting NAP as '${NAME}' on ${BRIDGE} (${ADDR}/${PREFIX}) (PIN ${PIN}; Just Works rejected)"

systemctl start bluetooth >/dev/null 2>&1 || true

for _ in $(seq 1 40); do
    if bluetoothctl show >/dev/null 2>&1; then
        break
    fi
    sleep 0.25
done
if ! bluetoothctl show >/dev/null 2>&1; then
    log "Bluetooth adapter did not become ready"
    exit 1
fi

killall bt-agent >/dev/null 2>&1 || true
killall pipedal-bt-agent >/dev/null 2>&1 || true
set_classic_nap_adapter
if [[ "$PAIRING_UNTIL" == 1 ]]; then
    set_pairing_visible 1
else
    set_pairing_visible 0
fi

ip link add name "$BRIDGE" type bridge 2>/dev/null || true
ip link add name "$DUMMY" type dummy 2>/dev/null || true
ip link set "$DUMMY" up >/dev/null 2>&1 || true
ip link set "$DUMMY" master "$BRIDGE" >/dev/null 2>&1 || true
ip addr flush dev "$BRIDGE" >/dev/null 2>&1 || true
ip addr add "${ADDR}/${PREFIX}" dev "$BRIDGE"
ip link set "$BRIDGE" up
ip link set "$BRIDGE" multicast on

registered=""
if command -v bt-network >/dev/null 2>&1; then
    bt-network -s nap "$BRIDGE" >/dev/null 2>&1 &
    NETWORK_PID=$!
    sleep 0.5
    if kill -0 "$NETWORK_PID" >/dev/null 2>&1; then
        registered="bt-network"
    else
        NETWORK_PID=""
    fi
fi
if [[ -z "$registered" ]]; then
    for adapter in /org/bluez/hci0 /org/bluez/hci1; do
        dbus-send --system --dest=org.bluez --type=method_call \
            "$adapter" org.bluez.NetworkServer1.Unregister string:nap \
            >/dev/null 2>&1 || true
        if dbus-send --system --dest=org.bluez --print-reply --type=method_call \
            "$adapter" org.bluez.NetworkServer1.Register string:nap string:"$BRIDGE" \
            >/dev/null 2>&1; then
            registered="$adapter"
            break
        fi
    done
fi
if [[ -z "$registered" ]]; then
    log "failed to register BlueZ NAP on pan0"
    exit 1
fi
log "registered NAP on ${registered}"
sleep 2
for adapter in /org/bluez/hci0 /org/bluez/hci1; do
    dbus-send --system --dest=org.bluez --print-reply --type=method_call \
        "$adapter" org.bluez.NetworkServer1.Register string:nap string:"$BRIDGE" \
        >/dev/null 2>&1 || true
done
if command -v hciconfig >/dev/null 2>&1; then
    hciconfig hci0 class 0x020100 >/dev/null 2>&1 || true
    log "adapter $(hciconfig hci0 class 2>/dev/null | tr '\n' ' ')"
fi

mkdir -p "$RUN_DIR"
umask 077
printf '* %s\n' "$PIN" > "$PIN_FILE"
chmod 600 "$PIN_FILE"
rm -f "$PAIRING_FLAG"

python3 /usr/sbin/pipedal-bt-agent "$PIN_FILE" &
AGENT_PID=$!
log "PIN agent: pipedal-bt-agent (Just Works rejected)"

(
    while true; do
        bluetoothctl devices Paired 2>/dev/null | awk '{print $2}' | while read -r mac; do
            [[ -z "$mac" ]] && continue
            bluetoothctl trust "$mac" >/dev/null 2>&1 || true
            connected="$(bluetoothctl info "$mac" 2>/dev/null | awk '/Connected:/ {print $2; exit}')"
            if [[ "$connected" != "yes" ]]; then
                log "connecting $mac for NAP"
                bluetoothctl connect "$mac" >/dev/null 2>&1 || true
            fi
        done
        sleep 8
    done
) &
TRUST_PID=$!

(
    last_name=""
    while true; do
        load_config
        printf '* %s\n' "$PIN" > "$PIN_FILE"
        if [[ "$NAME" != "$last_name" ]]; then
            bluetoothctl system-alias "$NAME" >/dev/null 2>&1 || bluetoothctl alias "$NAME" >/dev/null 2>&1 || true
            last_name="$NAME"
        fi
        if [[ "$PAIRING_UNTIL" == 1 ]]; then
            set_pairing_visible 1
        else
            set_pairing_visible 0
        fi
        sleep 2
    done
) &
KEEPALIVE_PID=$!

cat > "$DNSMASQ_CONF" <<EOF
# Isolated PAN: no default route, so the iPad keeps using Wi-Fi for internet.
# DNS on pan0 only so iPadOS keeps the Ethernet/PAN interface up.
interface=${BRIDGE}
except-interface=lo
bind-interfaces
listen-address=${ADDR}
port=53
address=/pipedal.local/${ADDR}
dhcp-range=${DHCP_START},${DHCP_END},255.255.255.0,12h
dhcp-option=option:router
dhcp-option=6,${ADDR}
log-dhcp
EOF

dnsmasq --keep-in-foreground --conf-file="$DNSMASQ_CONF" --dhcp-leasefile="$DNSMASQ_LEASES" --pid-file="${RUN_DIR}/bt-dnsmasq.pid" &
DNSMASQ_PID=$!

log "ready. Pair '${NAME}' with PIN ${PIN}, wait for Ethernet/PAN, then http://${ADDR}"

wait "$DNSMASQ_PID"
exit $?
