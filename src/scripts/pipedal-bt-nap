#!/bin/bash
# PiPedal Bluetooth NAP (Network Access Point).
#
# Gives the iPad a second, Bluetooth-only IP path to the Pi so the iPad can
# stay on Wi-Fi (or cellular) for internet. DHCP does not advertise a default
# route; the PAN is 172.21.0.0/24 with the Pi at 172.21.0.1.
#
# Hidden unless Settings → Bluetooth remote → Allow new devices (2 minutes).
# NAP is BR/EDR only. BLE Just Works pairing is disabled so a rando cannot
# "connect" without a PIN and without a network.

set -u

CONFIG_JSON="/var/pipedal/config/bluetoothConfig.json"
BRIDGE="pan0"
DUMMY="pan0-dummy"
ADDR="172.21.0.1"
PREFIX="24"
DHCP_START="172.21.0.10"
DHCP_END="172.21.0.50"
RUN_DIR="/run/pipedal"
DNSMASQ_CONF="${RUN_DIR}/bt-dnsmasq.conf"
DNSMASQ_LEASES="${RUN_DIR}/bt-dnsmasq.leases"
PIN_FILE="${RUN_DIR}/bt-pin"
PAIRING_FLAG="${RUN_DIR}/bt-pairing-on"
AGENT_PID=""
AGENT_READER_PID=""
TRUST_PID=""
KEEPALIVE_PID=""
NETWORK_PID=""
DNSMASQ_PID=""
AUTH_PID=""
BTCTL_PID=""
NAME=""
PIN=""
PAIRING_UNTIL=0
PAIRING_ACTIVE=0

log() {
    echo "pipedal-bt-nap: $*" >&2
}

load_config() {
    local loaded
    loaded="$(python3 - <<'PY' 2>/dev/null
import json, os, secrets, time
path = "/var/pipedal/config/bluetoothConfig.json"
data = {}
if os.path.exists(path):
    try:
        with open(path) as f:
            data = json.load(f)
    except Exception:
        data = {}
name = (data.get("deviceName") or "pipedal").strip() or "pipedal"
pin = str(data.get("pin") or "").strip()
changed = False
if not (pin.isdigit() and 4 <= len(pin) <= 8):
    pin = f"{secrets.randbelow(1000000):06d}"
    data["deviceName"] = name
    data["pin"] = pin
    data["enable"] = True
    changed = True
allow = data.get("allowNewDevices")
if allow is None:
    allow = True
if changed:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump(data, f)
print(name)
print(pin)
print(1 if allow else 0)
PY
)"
    NAME="$(printf '%s\n' "$loaded" | sed -n '1p')"
    PIN="$(printf '%s\n' "$loaded" | sed -n '2p')"
    PAIRING_UNTIL="$(printf '%s\n' "$loaded" | sed -n '3p')"
    if [[ -z "$NAME" ]]; then
        NAME="pipedal"
    fi
    if [[ ! "$PIN" =~ ^[0-9]{4,8}$ ]]; then
        log "failed to load a valid Bluetooth PIN"
        exit 1
    fi
    if [[ "$PAIRING_UNTIL" != "1" ]]; then
        PAIRING_UNTIL=0
    fi
}

hciconfig_try() {
    timeout 2 hciconfig "$@" >/dev/null 2>&1 || true
}

# Powered-on btmgmt with a timeout. Never `power off` — that wedges bcm4345.
btmgmt_try() {
    timeout 2 btmgmt "$@" >/dev/null 2>&1 || true
}

# Never call bluetoothctl. It registers its own agent, then exits and
# unregisters it, so the iPad PIN dialog has nobody on this side.
adapter_set() {
    local prop="$1"
    local value="$2"
    timeout 3 dbus-send --system --dest=org.bluez --type=method_call \
        /org/bluez/hci0 org.freedesktop.DBus.Properties.Set \
        string:org.bluez.Adapter1 string:"$prop" "$value" \
        >/dev/null 2>&1 || true
}

adapter_ready() {
    timeout 3 dbus-send --system --print-reply --dest=org.bluez \
        /org/bluez/hci0 org.freedesktop.DBus.Properties.Get \
        string:org.bluez.Adapter1 string:Address >/dev/null 2>&1
}

set_classic_nap_adapter() {
    # iPadOS prefers BLE and never shows a PIN keypad on that path.
    btmgmt_try le off
    btmgmt_try advertising off
    btmgmt_try sc off
    # Keypad PIN never arrives on HCI; PIN Code Reply Auth-Fails in ~100ms.
    # SSP is the link. Typed PIN interrupt is HTTP on pan0.
    btmgmt_try ssp on
    hciconfig_try hci0 up
    hciconfig_try hci0 class 0x020100
    hciconfig_try hci0 sspmode 1
    hciconfig_try hci0 noleadv
    hciconfig_try hci0 piscan
    adapter_set Powered "variant:boolean:true"
    adapter_set Alias "variant:string:${NAME}"
    local i
    for i in 1 2 3 4 5; do
        if hciconfig hci0 sspmode 2>/dev/null | grep -q Enabled; then
            log "link up with SSP; type PIN ${PIN} at http://${ADDR}"
            return 0
        fi
        btmgmt_try ssp on
        hciconfig_try hci0 sspmode 1
        sleep 0.3
    done
    log "WARNING: SSP still disabled"
}

set_pairing_visible() {
    local on="$1"
    if [[ "$on" == 1 ]]; then
        # DBus only. btmgmt/hciconfig here races PIN Code Reply and iPad
        # drops the ACL with Authentication Failure.
        adapter_set Pairable "variant:boolean:true"
        adapter_set DiscoverableTimeout "variant:uint32:0"
        adapter_set Discoverable "variant:boolean:true"
        touch "$PAIRING_FLAG"
        if [[ "$PAIRING_ACTIVE" != 1 ]]; then
            log "pairing window open. After BT connects, type PIN ${PIN} at http://${ADDR}"
        fi
        PAIRING_ACTIVE=1
    else
        rm -f "$PAIRING_FLAG"
        adapter_set Pairable "variant:boolean:false"
        adapter_set Discoverable "variant:boolean:false"
        if [[ "$PAIRING_ACTIVE" == 1 ]]; then
            log "pairing window closed. adapter hidden; paired devices can still reconnect"
        fi
        PAIRING_ACTIVE=0
    fi
}

cleanup() {
    if [[ -n "${DNSMASQ_PID}" ]]; then
        kill "${DNSMASQ_PID}" >/dev/null 2>&1 || true
    fi
    if [[ -n "${NETWORK_PID}" ]]; then
        kill "${NETWORK_PID}" >/dev/null 2>&1 || true
    fi
    if [[ -n "${AGENT_PID}" ]]; then
        kill "${AGENT_PID}" >/dev/null 2>&1 || true
    fi
    if [[ -n "${AGENT_READER_PID}" ]]; then
        kill "${AGENT_READER_PID}" >/dev/null 2>&1 || true
    fi
    if [[ -n "${TRUST_PID}" ]]; then
        kill "${TRUST_PID}" >/dev/null 2>&1 || true
    fi
    if [[ -n "${KEEPALIVE_PID}" ]]; then
        kill "${KEEPALIVE_PID}" >/dev/null 2>&1 || true
    fi
    if [[ -n "${BTCTL_PID}" ]]; then
        kill "${BTCTL_PID}" >/dev/null 2>&1 || true
    fi
    if [[ -n "${AUTH_PID}" ]]; then
        kill "${AUTH_PID}" >/dev/null 2>&1 || true
    fi
    nft delete table ip pipedal_bt >/dev/null 2>&1 || true
    rm -f "$PAIRING_FLAG" /run/pipedal/bt-unlocked
    for adapter in /org/bluez/hci0 /org/bluez/hci1; do
        dbus-send --system --dest=org.bluez --type=method_call \
            "$adapter" org.bluez.NetworkServer1.Unregister string:nap \
            >/dev/null 2>&1 || true
    done
    ip link set "$DUMMY" nomaster >/dev/null 2>&1 || true
    ip link delete "$DUMMY" >/dev/null 2>&1 || true
    ip addr flush dev "$BRIDGE" >/dev/null 2>&1 || true
    ip link set "$BRIDGE" down >/dev/null 2>&1 || true
    ip link delete "$BRIDGE" type bridge >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

if [[ ! -d /sys/class/bluetooth ]] || [[ -z "$(ls -A /sys/class/bluetooth 2>/dev/null)" ]]; then
    log "no Bluetooth adapter found"
    exit 1
fi

if ! command -v dbus-send >/dev/null 2>&1; then
    log "dbus-send not found"
    exit 1
fi
if ! command -v dnsmasq >/dev/null 2>&1; then
    log "dnsmasq not found"
    exit 1
fi

modprobe bnep >/dev/null 2>&1 || true
modprobe bridge >/dev/null 2>&1 || true
modprobe dummy >/dev/null 2>&1 || true

load_config
log "starting NAP as '${NAME}' on ${BRIDGE} (${ADDR}/${PREFIX}) (PIN ${PIN}; Just Works rejected)"

systemctl start bluetooth >/dev/null 2>&1 || true

for _ in $(seq 1 40); do
    if adapter_ready; then
        break
    fi
    sleep 0.25
done
if ! adapter_ready; then
    log "Bluetooth adapter did not become ready"
    exit 1
fi

killall bt-agent >/dev/null 2>&1 || true
killall pipedal-bt-agent >/dev/null 2>&1 || true

# Bridge must exist before NAP register. Adapter setup must not block this.
ip link add name "$BRIDGE" type bridge 2>/dev/null || true
ip link add name "$DUMMY" type dummy 2>/dev/null || true
ip link set "$DUMMY" up >/dev/null 2>&1 || true
ip link set "$DUMMY" master "$BRIDGE" >/dev/null 2>&1 || true
ip addr flush dev "$BRIDGE" >/dev/null 2>&1 || true
ip addr add "${ADDR}/${PREFIX}" dev "$BRIDGE" 2>/dev/null || true
ip link set "$BRIDGE" up
ip link set "$BRIDGE" multicast on

set_classic_nap_adapter
if [[ "$PAIRING_UNTIL" == 1 ]]; then
    set_pairing_visible 1
else
    set_pairing_visible 0
fi

registered=""
if command -v bt-network >/dev/null 2>&1; then
    bt-network -s nap "$BRIDGE" >/dev/null 2>&1 &
    NETWORK_PID=$!
    sleep 0.5
    if kill -0 "$NETWORK_PID" >/dev/null 2>&1; then
        registered="bt-network"
    else
        NETWORK_PID=""
    fi
fi
if [[ -z "$registered" ]]; then
    for adapter in /org/bluez/hci0 /org/bluez/hci1; do
        dbus-send --system --dest=org.bluez --type=method_call \
            "$adapter" org.bluez.NetworkServer1.Unregister string:nap \
            >/dev/null 2>&1 || true
        if dbus-send --system --dest=org.bluez --print-reply --type=method_call \
            "$adapter" org.bluez.NetworkServer1.Register string:nap string:"$BRIDGE" \
            >/dev/null 2>&1; then
            registered="$adapter"
            break
        fi
    done
fi
if [[ -z "$registered" ]]; then
    log "failed to register BlueZ NAP on pan0"
    exit 1
fi
log "registered NAP on ${registered}"
sleep 2
for adapter in /org/bluez/hci0 /org/bluez/hci1; do
    dbus-send --system --dest=org.bluez --print-reply --type=method_call \
        "$adapter" org.bluez.NetworkServer1.Register string:nap string:"$BRIDGE" \
        >/dev/null 2>&1 || true
done
if command -v hciconfig >/dev/null 2>&1; then
    hciconfig hci0 class 0x020100 >/dev/null 2>&1 || true
    log "adapter $(hciconfig hci0 class 2>/dev/null | tr '\n' ' ')"
fi

mkdir -p "$RUN_DIR"
umask 077
printf '* %s\n' "$PIN" > "$PIN_FILE"
chmod 600 "$PIN_FILE"

python3 /usr/sbin/pipedal-bt-agent "$PIN_FILE" &
AGENT_PID=$!
log "PIN agent: pipedal-bt-agent (link only; PIN interrupt at http://${ADDR})"

(
    while true; do
        python3 - <<'PY' >/dev/null 2>&1 || true
import dbus
bus = dbus.SystemBus()
mngr = dbus.Interface(bus.get_object("org.bluez", "/"), "org.freedesktop.DBus.ObjectManager")
for path, ifaces in mngr.GetManagedObjects().items():
    dev = ifaces.get("org.bluez.Device1")
    if not dev or not dev.get("Paired"):
        continue
    try:
        dbus.Interface(bus.get_object("org.bluez", path), "org.freedesktop.DBus.Properties").Set(
            "org.bluez.Device1", "Trusted", dbus.Boolean(True)
        )
    except Exception:
        pass
PY
        sleep 8
    done
) &
TRUST_PID=$!

(
    last_name=""
    while true; do
        load_config
        printf '* %s\n' "$PIN" > "$PIN_FILE"
        if [[ "$NAME" != "$last_name" ]]; then
            adapter_set Alias "variant:string:${NAME}"
            last_name="$NAME"
        fi
        if [[ "$PAIRING_UNTIL" == 1 ]]; then
            if [[ "$PAIRING_ACTIVE" != 1 ]]; then
                set_pairing_visible 1
            fi
        else
            if [[ "$PAIRING_ACTIVE" == 1 ]]; then
                set_pairing_visible 0
            fi
        fi
        sleep 2
    done
) &
KEEPALIVE_PID=$!

cat > "$DNSMASQ_CONF" <<EOF
# Isolated PAN: no default route, so the iPad keeps using Wi-Fi for internet.
# DNS on pan0 only so iPadOS keeps the Ethernet/PAN interface up.
interface=${BRIDGE}
except-interface=lo
bind-interfaces
listen-address=${ADDR}
port=53
address=/pipedal.local/${ADDR}
dhcp-range=${DHCP_START},${DHCP_END},255.255.255.0,12h
dhcp-option=option:router
dhcp-option=6,${ADDR}
log-dhcp
EOF

dnsmasq --keep-in-foreground --conf-file="$DNSMASQ_CONF" --dhcp-leasefile="$DNSMASQ_LEASES" --pid-file="${RUN_DIR}/bt-dnsmasq.pid" &
DNSMASQ_PID=$!

python3 /usr/sbin/pipedal-bt-auth "$PIN_FILE" &
AUTH_PID=$!
log "PIN interrupt: type ${PIN} at http://${ADDR} after Bluetooth connects"

log "ready. Pair '${NAME}', then type PIN ${PIN} at http://${ADDR}"

wait "$DNSMASQ_PID"
exit $?
